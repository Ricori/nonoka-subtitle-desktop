<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
		Path="nonoka_subtitle_wails.exe"
        Arguments=""
		InstallLocation="C:\Program Files\Takamichika\NONOKA SUBTITLE">
    </Installer>
    <PackageInformation
		PackageName="NONOKA SUBTITLE"
		PackageDisplayName="NONOKA SUBTITLE"
        PublisherName="CN=Takamichika"
        PublisherDisplayName="Takamichika"
        Version="0.6.2.0"
		PackageDescription="Wails v3 desktop implementation">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
				Id="online.nonoka.subtitle"
				Description="Wails v3 desktop implementation"
				DisplayName="NONOKA SUBTITLE"
				ExecutableName="nonoka_subtitle_wails.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
			<DisplayName>NONOKA SUBTITLE</DisplayName>
            <PublisherDisplayName>Takamichika</PublisherDisplayName>
			<Description>Wails v3 desktop implementation</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
	<SaveLocation PackagePath="nonoka_subtitle_wails.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
